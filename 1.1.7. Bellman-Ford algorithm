#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

#define INF LLONG_MAX

// Structure to represent a weighted edge
typedef struct {
    int u, v;
    long long w;
} Edge;

// Recursive function to print the path from source to current vertex
void printPath(int vertex, int parent[], int src) {
    if (vertex == src) {
        printf("%d", src);
        return;
    }
    printPath(parent[vertex], parent, src);
    printf("->%d", vertex);
}

int main() {
    int V, E;
    if (scanf("%d", &V) != 1) return 0;
    if (scanf("%d", &E) != 1) return 0;

    Edge* edges = (Edge*)malloc(E * sizeof(Edge));
    for (int i = 0; i < E; i++) {
        scanf("%d %d %lld", &edges[i].u, &edges[i].v, &edges[i].w);
    }

    int src;
    scanf("%d", &src);

    // Initialize distances and parents
    long long* dist = (long long*)malloc((V + 1) * sizeof(long long));
    int* parent = (int*)malloc((V + 1) * sizeof(int));

    for (int i = 1; i <= V; i++) {
        dist[i] = INF;
        parent[i] = -1;
    }
    dist[src] = 0;

    // Relax all edges V - 1 times
    for (int i = 1; i <= V - 1; i++) {
        for (int j = 0; j < E; j++) {
            int u = edges[j].u;
            int v = edges[j].v;
            long long w = edges[j].w;

            if (dist[u] != INF && dist[u] + w < dist[v]) {
                dist[v] = dist[u] + w;
                parent[v] = u;
            }
        }
    }

    // Check for negative-weight cycles
    int hasNegativeCycle = 0;
    for (int j = 0; j < E; j++) {
        int u = edges[j].u;
        int v = edges[j].v;
        long long w = edges[j].w;

        if (dist[u] != INF && dist[u] + w < dist[v]) {
            hasNegativeCycle = 1;
            break;
        }
    }

    // Print output matching the test case expectations
    if (hasNegativeCycle) {
        printf("Negative cycle detected\n");
    } else {
        for (int i = 1; i <= V; i++) {
            if (i == src) continue; // Skip the source vertex as per instructions

            if (dist[i] == INF) {
                printf("%d INF None\n", i);
            } else {
                printf("%d %lld ", i, dist[i]);
                printPath(i, parent, src);
                printf("\n");
            }
        }
    }

    // Clean up allocated memory blocks
    free(edges);
    free(dist);
    free(parent);

    return 0;
}


