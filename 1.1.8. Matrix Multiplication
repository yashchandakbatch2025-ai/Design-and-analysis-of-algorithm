#include <stdio.h>

int main() {
    int r1, c1;
    // Read dimensions of matrix A
    if (scanf("%d %d", &r1, &c1) != 2) return 0;

    int A[r1][c1];
    // Read elements of matrix A
    for (int i = 0; i < r1; i++) {
        for (int j = 0; j < c1; j++) {
            scanf("%d", &A[i][j]);
        }
    }

    int r2, c2;
    // Read dimensions of matrix B
    if (scanf("%d %d", &r2, &c2) != 2) return 0;

    // Check if matrix multiplication is possible
    if (c1 != r2) {
        printf("Invalid input\n");
        return 0; // Skip reading elements of matrix B and terminate
    }

    int B[r2][c2];
    // Read elements of matrix B since multiplication is possible
    for (int i = 0; i < r2; i++) {
        for (int j = 0; j < c2; j++) {
            scanf("%d", &B[i][j]);
        }
    }

    // Initialize result matrix with dimensions (r1 x c2) to 0
    int C[r1][c2];
    for (int i = 0; i < r1; i++) {
        for (int j = 0; j < c2; j++) {
            C[i][j] = 0;
        }
    }

    // Perform matrix multiplication
    for (int i = 0; i < r1; i++) {
        for (int j = 0; j < c2; j++) {
            for (int k = 0; k < c1; k++) {
                C[i][j] += A[i][k] * B[k][j];
            }
        }
    }

    // Display the resulting product matrix
    for (int i = 0; i < r1; i++) {
        for (int j = 0; j < c2; j++) {
            printf("%d", C[i][j]);
            if (j < c2 - 1) {
                printf(" "); // Space between elements
            }
        }
        printf(" \n"); // Newline after each row
    }

    return 0;
}
