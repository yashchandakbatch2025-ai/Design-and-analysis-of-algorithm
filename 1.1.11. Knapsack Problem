#include <stdio.h>
#include <stdlib.h>

int main() {
    int N, W;
    
 
    if (scanf("%d", &N) != 1) return 0;
    
    int *values = (int *)malloc(N * sizeof(int));
    int *weights = (int *)malloc(N * sizeof(int));
    
 
    for (int i = 0; i < N; i++) {
        if (scanf("%d", &values[i]) != 1) return 0;
    }
    
  
    for (int i = 0; i < N; i++) {
        if (scanf("%d", &weights[i]) != 1) return 0;
    }
    
  
    if (scanf("%d", &W) != 1) return 0;
    
  
    int *dp = (int *)calloc(W + 1, sizeof(int));
    
   
    for (int i = 0; i < N; i++) {
        int val = values[i];
        int wt = weights[i];
        for (int j = W; j >= wt; j--) {
            if (dp[j - wt] + val > dp[j]) {
                dp[j] = dp[j - wt] + val;
            }
        }
    }
    
   
    printf("%d\n", dp[W]);
    
 
    free(values);
    free(weights);
    free(dp);
    
    return 0;
}

